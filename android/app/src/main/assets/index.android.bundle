\u0436\u0434\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b. \u0411\u0443\u0434\u044c \u0442\u044b \u0444\u043b\u043e\u0440\u0438\u0441\u0442\u043e\u043c, \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u043c, \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u043c \u0438\u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0439 \u0438\u0434\u0435\u0435\u0439 \u2014 \u0432 Chamba \u043d\u0430\u0439\u0434\u0435\u0442\u0441\u044f \u043c\u0435\u0441\u0442\u043e \u0434\u043b\u044f \u0442\u0432\u043e\u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u0430."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043b\u0435\u043d\u0442\u0430. \u0421\u043e\u0437\u0434\u0430\u0439 \u0441\u0432\u043e\u044e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u043b\u0435\u043d\u0442\u0443 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0440\u0443\u0431\u0440\u0438\u043a."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u041f\u043e\u043f\u0443\u0442\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442. \u041a\u043e\u043d\u0442\u0435\u043d\u0442 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e \u0438\u043b\u0438 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u043c\u0438 \u0442\u043e\u0431\u043e\u044e \u0440\u0443\u0431\u0440\u0438\u043a\u0430\u043c\u0438."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u0420\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430. \u041d\u0430\u0448\u0438 \u0440\u0443\u0431\u0440\u0438\u043a\u0438 \u2013 \u044d\u0442\u043e \u043a\u0430\u043b\u0435\u0439\u0434\u043e\u0441\u043a\u043e\u043f \u0436\u0430\u043d\u0440\u043e\u0432 \u0438 \u0441\u0442\u0438\u043b\u0435\u0439."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442. \u041a\u043e\u043d\u0442\u0435\u043d\u0442 \u0438\u0437 \u0442\u0432\u043e\u0435\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0430. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u043c\u0435\u0441\u0442\u0430, \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u044b, \u0430\u0432\u0442\u043e/\u043c\u043e\u0442\u043e\u0432\u044b\u0441\u0442\u0430\u0432\u043a\u0438, \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043b\u0438 \u0438 \u0442.\u0434."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u0445 \u043f\u043e \u0441\u0444\u0435\u0440\u0435/\u043e\u0442\u0440\u0430\u0441\u043b\u0438. \u0421\u043c\u043e\u0442\u0440\u0438 \u043a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0442\u0432\u043e\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u0431\u0443\u0434\u044c \u0432 \u043a\u0443\u0440\u0441\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u0442\u0440\u0435\u043d\u0434\u043e\u0432!"}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u0410\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0430 \u0442\u0432\u043e\u0435\u0433\u043e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439. \u0410)\u041f\u0440\u043e\u043a\u0430\u0447\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u043d\u0435\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438, \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0443\u0431\u0440\u0438\u043a \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u044f\u0442\u0441\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0438\u0445 \u0443\u0432\u0438\u0434\u0435\u043b\u0438 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043b\u044e\u0434\u0438."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u0411)\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440: \u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0441 \u043f\u043b\u044f\u0436\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044b \u0441\u0435\u0440\u0444\u0438\u043d\u0433\u0438\u0441\u0442, \u0437\u0430\u043a\u0430\u0442 \u0438 \u044d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043a\u0442\u0435\u0439\u043b\u044c. \u041e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u0447\u0442\u043e \u043e\u043d\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430 \u043a\u0430\u043a \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044f\u043c \u0441\u0435\u0440\u0444\u0438\u043d\u0433\u0430, \u0442\u0430\u043a \u0438 \u0446\u0435\u043d\u0438\u0442\u0435\u043b\u044f\u043c \u0437\u0430\u043a\u0430\u0442\u043e\u0432, \u0438 \u0434\u0430\u0436\u0435 \u0442\u0435\u043c, \u043a\u0442\u043e \u0438\u0449\u0435\u0442 \u0438\u0434\u0435\u0438 \u0434\u043b\u044f \u043a\u043e\u043a\u0442\u0435\u0439\u043b\u0435\u0439. \u0420\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0432 \u044d\u0442\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u0432 \u0440\u0443\u0431\u0440\u0438\u043a\u0430\u0445 \"\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043e\u0442\u0434\u044b\u0445\", \"\u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u0435 \u044f\u0432\u043b\u0435\u043d\u0438\u044f\" \u0438 \"\u0435\u0434\u0430 \u0438 \u043d\u0430\u043f\u0438\u0442\u043a\u0438\", \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u044b\u043b\u043e\u0436\u0438\u0442\u044c \u043e\u0434\u043d\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u043e\u0442 1-\u043e\u0439 \u0434\u043e 4-\u0445 \u0440\u0443\u0431\u0440\u0438\u043a, \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0434\u043b\u044f \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435 \u0448\u0438\u0440\u043e\u043a\u043e\u0439 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438, \u0440\u0430\u0437\u0433\u043e\u043d\u044f\u044f \u0448\u0430\u043d\u0441\u044b \u0431\u044b\u0442\u044c \u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u043c \u0438 \u043e\u0446\u0435\u043d\u0435\u043d\u043d\u044b\u043c."}),(0,s.jsx)(t.Text,{style:r(d[6]).Styles.BlackRegular12,children:"\u25a0\u0412\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430, \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u043e \u0441\u0435\u0431\u0435 \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u04